{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "COVERAGE_SCOPE",
    "E2E_APP",
    "EXPOSE_TESTING_API",
    "FORCE_COLOR",
    "GENERATOR_BENCH_ITERATIONS",
    "GENERATOR_BENCH_OUTPUT",
    "NEXT_OPENAPI_GEN_TIMING",
    "NODE_ENV",
    "PATH",
    "PAYMENT_WEBHOOK_SECRET",
    "WEBHOOK_SECRET"
  ],
  "tasks": {
    "//#knip": {
      "dependsOn": ["next-openapi-gen#build"],
      "outputs": []
    },
    "//#knip:ci": {
      "dependsOn": ["next-openapi-gen#build"],
      "outputs": []
    },
    "//#test:e2e": {
      "cache": false,
      "outputs": []
    },
    "//#test:integration": {
      "dependsOn": ["transit", "next-openapi-gen#build"],
      "outputs": []
    },
    "//#transit": {
      "dependsOn": ["^transit"]
    },
    "test:coverage": {
      "dependsOn": ["transit", "next-openapi-gen#build"],
      "outputs": ["coverage/**"]
    },
    "//#test:unit": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "tsconfig.tsbuildinfo"]
    },
    "check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format:check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "generate": {
      "dependsOn": ["^build"],
      "env": ["GENERATE_CLIENT_SDK", "OPENAPI_GEN_CACHE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "next.openapi.json",
        "openapi-gen.config.json",
        "openapi-gen.config.ts",
        "openapi-gen.config.mts",
        "next-openapi.config.ts",
        "next-openapi.config.mts",
        "scripts/**",
        "src/**"
      ],
      "outputs": ["public/openapi.json", ".openapi-gen/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": ["tsconfig.tsbuildinfo"]
    }
  }
}
